orion/docker-compose.yml:
version: '3.7'
services:
  # ----------------------------------
  # 1. MongoDB (Banco de Dados)
  # ----------------------------------
  mongodb:
    image: mongo:latest
    container_name: mongodb
    ports:
      - "27017:27017"
    volumes:
      - mongodb_data:/data/db
    restart: always

  # ----------------------------------
  # 2. Orion Context Broker (Cérebro do Contexto)
  # ----------------------------------
  orion:
    image: fiware/orion:latest
    container_name: fiware-orion
    ports:
      - "1026:1026"
    depends_on:
      - mongodb
    # Conexão robusta ao MongoDB usando variáveis de ambiente
    environment:
      - ORION_MONGO_URI=mongodb://mongodb:27017
      - ORION_LOG_LEVEL=DEBUG
    restart: always

  # ----------------------------------
  # 3. IoT Agent (Tradutor de Protocolo)
  # ----------------------------------
  iota-ul:
    image: fiware/iotagent-ul:latest
    container_name: fiware-iota-ul
    hostname: iota-ul
    ports:
      # Porta para comunicação do dispositivo (ESP8266) e administração
      - "7896:7896"
    environment:
      - IOTA_CB_HOST=orion              # Hostname interno do Broker
      - IOTA_CB_PORT=1026
      - IOTA_NORTH_PORT=7896           # Porta de administração (para provisionamento)
      - IOTA_INCOMING_PORT=7896        # Porta de tráfego do dispositivo
      - IOTA_PROTOCOL=UL20             # Protocolo UltraLight 2.0
      - IOTA_API_KEY=4jgt4tywsy4ygh2480648 # Chave de segurança
      - IOTA_SERVICE=minha_casa        # Serviço FIWARE
      - IOTA_SERVICE_PATH=/
      - IOTA_MONGO_HOST=mongodb        # Hostname interno do Mongo
      - IOTA_MONGO_PORT=27017
      - IOTA_MONGO_DB=iotagentul
    depends_on:
      - orion
      - mongodb
    restart: always

volumes:
  mongodb_data:



