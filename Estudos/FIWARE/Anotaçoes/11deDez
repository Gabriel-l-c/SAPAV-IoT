codigo esp8266:

#include <ESP8266HTTPClient.h>
#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>

// --- Configurações de Rede ---
const char* APN = "nerds"; 
const char* PASS = "nerds23517891";

// --- Configurações do Dispositivo FIWARE ---
// ATENÇÃO: ESTE IP DEVE SER ATUALIZADO PARA O NOVO IP WI-FI DO PC!
const char* IOTA_HOST = "172.16.30.83"; 
const int IOTA_PORT = 7896;
const char* API_KEY = "4jgt4tywsy4ygh2480648";
const char* DEVICE_ID = "lamp01"; 
const char* RESOURCE_PATH = "/"; // Caminho simplificado para evitar 404
const int COMMAND_PORT = 80; 

// --- Configurações de Hardware ---
const int LED_PIN = 13; // GPIO 13
bool led_state = false;

ESP8266WebServer server(COMMAND_PORT);
WiFiClient client;

// FUNÇÃO PARA PROCESSAR O COMANDO RECEBIDO DO IOT AGENT
void processCommand() {
  String command = server.arg(0);
  if (command.startsWith("comandoLED|")) {
    String value = command.substring(11);
    
    if (value.equals("ON")) {
      digitalWrite(LED_PIN, HIGH);
      led_state = true;
      Serial.println("Comando: LIGAR LED");
    } else if (value.equals("OFF")) {
      digitalWrite(LED_PIN, LOW);
      led_state = false;
      Serial.println("Comando: DESLIGAR LED");
    }

    String responseBody = "comandoLED@ok|"; 
    server.send(200, "text/plain", responseBody);
    reportStatus(); // Reporta a mudança de estado
  } else {
    server.send(400, "text/plain", "Comando desconhecido.");
  }
}

// FUNÇÃO PARA ENVIAR O STATUS ATUAL (SALA DE SENSOR)
void reportStatus() {
  HTTPClient http;
  String url = "http://" + String(IOTA_HOST) + ":" + String(IOTA_PORT) + 
               String(RESOURCE_PATH) + "?k=" + String(API_KEY) + "&i=" + String(DEVICE_ID);

  http.begin(client, url);
  http.addHeader("Content-Type", "text/plain");

  // Corpo da requisição no formato UltraLight: s|ON ou s|OFF
  String status_val = led_state ? "ON" : "OFF";
  String payload = "s|" + status_val;
  
  int httpCode = http.POST(payload);

  if (httpCode > 0) {
    Serial.printf("Status reportado. Código HTTP: %d\n", httpCode);
  } else {
    Serial.printf("Falha no reporte HTTP. Erro: %s\n", http.errorToString(httpCode).c_str());
  }
  http.end();
}

void setup() {
  Serial.begin(115200);
  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW);
  
  WiFi.begin(APN, PASS);
  Serial.print("Conectando ao WiFi...");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println(" Conectado!");
  Serial.print("IP do ESP8266: ");
  Serial.println(WiFi.localIP());

  server.on("/iot/ul", HTTP_POST, processCommand); // IoTA envia comandos para este endpoint
  server.begin();
  
  reportStatus(); 
}

void loop() {
  server.handleClient();
  delay(10); 
}
