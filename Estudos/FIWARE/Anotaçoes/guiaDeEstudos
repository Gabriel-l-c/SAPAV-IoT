com docker ja baixo e setado:

inicialização:

docker pull mongo:3.6
docker pull fiware/orion
docker network create fiware_default

star up:

//comecar e conectar na network docer -> mongo

docker run -d --name=context-db --network=fiware_default \
  --expose=27017 mongo:3.6 --bind_ip_all --smallfiles

//Orion context broker conecta rna network
docker run -d --name orion  --network=fiware_default \
  -p 1026:1026  fiware/orion -dbhost context-db

//chegar se orion foi conectado
curl -X GET http://localhost:1026/version

